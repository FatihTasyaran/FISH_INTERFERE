# Generated by Claude Fable 5 (Anthropic)
# fishiris — one self-contained container: PostgreSQL/TimescaleDB with the exported
# FISH session(s) + the FISH viz server (all popup views, fishiris landing page) +
# Grafana with the T0 dashboard. No GPU, no ROS, no traces to process: data only.
#
#   build:  docker build -f docker/fishiris/Dockerfile -t fishiris:r11 .      (repo root as context)
#   run:    docker run -d --name fishiris -p 8783:8783 -p 3000:3000 \
#             -e PUBLIC_VIZ_URL=http://<server>:8783 -e PUBLIC_GRAFANA_URL=http://<server>:3000 fishiris:r11
#   open:   http://<server>:8783/fishiris/   (Grafana admin / fishiris)
FROM timescale/timescaledb:2.17.2-pg16

ARG GRAFANA_VERSION=11.6.1
ENV LANG=C.UTF-8 PYTHONUNBUFFERED=1 \
    POSTGRES_USER=fish POSTGRES_PASSWORD=fish POSTGRES_DB=fish \
    FISH_PG_DSN="host=localhost port=5432 dbname=fish user=fish password=fish" \
    PUBLIC_VIZ_URL=http://localhost:8783 PUBLIC_GRAFANA_URL=http://localhost:3000 \
    GF_PATHS_PROVISIONING=/opt/grafana/conf/provisioning GF_SECURITY_ADMIN_PASSWORD=fishiris

# python + graphviz for the viz server (Alpine base of the timescale image)
RUN apk add --no-cache python3 py3-psycopg2 py3-networkx graphviz ttf-dejavu curl bash libc6-compat gzip

# Grafana OSS (static binary tarball) + the panel plugin the T0 dashboard uses
RUN mkdir -p /opt/grafana && cd /opt/grafana \
 && curl -fsSL "https://dl.grafana.com/oss/release/grafana-${GRAFANA_VERSION}.linux-amd64.tar.gz" | tar xz --strip-components=1 \
 && /opt/grafana/bin/grafana cli --pluginsDir /opt/grafana/data/plugins plugins install gapit-htmlgraphics-panel \
 && mkdir -p /opt/grafana/conf/provisioning/datasources /opt/grafana/conf/provisioning/dashboards /opt/grafana/dashboards

# FISH viz server + landing page + schema + exported data
COPY postprocess/ /opt/fish/postprocess/
COPY site/ /opt/fish/site/
COPY scripts/init_fish_pg.sql /opt/fish/init_fish_pg.sql
COPY docker/fishiris/data/ /opt/fish/data/
COPY docker/fishiris/provisioning/ /opt/grafana/conf/provisioning/
COPY docker/fishiris/entrypoint.sh /opt/fish/entrypoint.sh
RUN chmod +x /opt/fish/entrypoint.sh && cp /opt/fish/data/T0_dashboard.json /opt/grafana/dashboards/T0.json

EXPOSE 8783 3000 5432
ENTRYPOINT ["/opt/fish/entrypoint.sh"]
