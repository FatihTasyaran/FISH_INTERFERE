// Generated by Claude Opus 5 (Anthropic)
// Panel (d) conditional graph in the Miro colours: yellow = common to every
// execution, blue = branch of the DOM signature, red = branch of the VAR one.
// It is the conditional graph of exactly the two typed DAGs drawn above it:
//   DOM (x74) : CPU CE SM SM SM SM CE CPU
//   VAR (x26) : CPU CE SM CE    SM CE CPU
//   backbone  : CPU CE SM  .    SM CE CPU   (longest common subsequence)
//   DOM inserts [SM SM] and VAR inserts [CE] at the same point — that is what
//   makes a single decision node legitimate.
digraph cond_panel_d {
  rankdir=LR;
  bgcolor="transparent";
  node [shape=box, style="filled", fontname="Helvetica", fontsize=10,
        margin="0.06,0.04", color="#333333"];
  edge [fontname="Helvetica", fontsize=10, color="#333333", arrowsize=0.7];
  graph [nodesep=0.22, ranksep=0.30];

  y0 [label="[CPU]", fillcolor="#F5C518"];
  y1 [label="[CE]",  fillcolor="#F5C518"];
  y2 [label="[SM]",  fillcolor="#F5C518"];
  d  [shape=diamond, label="", width=0.22, height=0.20, fixedsize=true,
      fillcolor="#FFFFFF", style=filled];
  y3 [label="[SM]",  fillcolor="#F5C518"];
  y4 [label="[CE]",  fillcolor="#F5C518"];
  y5 [label="[CPU]", fillcolor="#F5C518"];

  b0 [label="[SM]", fillcolor="#4472C4", fontcolor="white"];
  b1 [label="[SM]", fillcolor="#4472C4", fontcolor="white"];
  r0 [label="[CE]", fillcolor="#C00000", fontcolor="white"];

  y0 -> y1;
  y1 -> y2;
  y2 -> d  [arrowhead=none];
  d  -> b0 [label="74%"];
  b0 -> b1;
  b1 -> y3;
  d  -> r0 [label="26%"];
  r0 -> y3;
  y3 -> y4;
  y4 -> y5;
}
