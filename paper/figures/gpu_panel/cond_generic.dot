// Generated by Claude Opus 5 (Anthropic)
// Generic conditional graph for the model figure's GPU quadrant — the schematic
// counterpart of the two typed DAGs (DOM / VAR) drawn above it.  Same visual
// language as postprocess/dag_conditional.py: blue skeleton cluster, diamond
// decision node, branch blocks in the colour of the signature class that takes
// them (green = dominant, grey = variant), shares conditional on reaching the
// decision.  No session-specific names or counts: it states the construction,
// not one measurement.
digraph cond_generic {
  rankdir=LR;
  bgcolor="transparent";
  node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=9, margin="0.07,0.035"];
  edge [fontname="Helvetica", fontsize=8];
  graph [nodesep=0.18, ranksep=0.34];

  subgraph cluster_skel {
    label="skeleton (common to every execution)";
    style="filled,rounded"; fillcolor="#F0F7FF"; color="#1976D2";
    fontname="Helvetica-Bold"; fontsize=9;

    sk0 [label="0\nCPU", fillcolor="#BBDEFB"];
    sk1 [label="1\nCE",  fillcolor="#BBDEFB"];
    sk2 [label="2\nSM",  fillcolor="#BBDEFB"];
    d   [shape=diamond, style=filled, label="", width=0.34, height=0.30, fixedsize=true,
         fillcolor="#FFFFFF", color="#1976D2", penwidth=1.5];
    sk3 [label="3\nSM",  fillcolor="#BBDEFB"];
    sk4 [label="4\nCE",  fillcolor="#BBDEFB"];
    sk5 [label="5\nCPU", fillcolor="#BBDEFB"];

    sk0 -> sk1 [color="#1976D2", penwidth=2, label="100%", fontcolor="#1976D2"];
    sk1 -> sk2 [color="#1976D2", penwidth=2, label="100%", fontcolor="#1976D2"];
    sk2 -> d   [color="#1976D2", penwidth=2, arrowhead=none];
    d   -> sk3 [style=invis, weight=10];   // keeps the backbone on one line
    sk3 -> sk4 [color="#1976D2", penwidth=2, label="100%", fontcolor="#1976D2"];
    sk4 -> sk5 [color="#1976D2", penwidth=2, label="100%", fontcolor="#1976D2"];
  }

  brd [label="dominant\nsignature\nSM\nSM", fillcolor="#2E7D32", fontcolor="white"];
  brv [label="variant\nsignature\nCE",     fillcolor="#9E9E9E", fontcolor="white"];

  d   -> brd [color="#2E7D32", style=dashed, label="p", fontcolor="#2E7D32"];
  brd -> sk3 [color="#2E7D32", style=dashed, constraint=false];
  d   -> brv [color="#9E9E9E", style=dashed, label="1−p", fontcolor="#9E9E9E"];
  brv -> sk3 [color="#9E9E9E", style=dashed, constraint=false];
}
