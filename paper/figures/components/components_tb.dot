digraph components {
  rankdir=TB;
  newrank=true;
  graph [fontname="Helvetica" fontsize=22 nodesep=0.55 ranksep=0.85 bgcolor="white" splines=spline];
  node  [shape=box style="filled,rounded" fontname="Helvetica" fontsize=22 fillcolor="#3aa6b0" color="#2a7f87" fontcolor="white" penwidth=2 margin="0.28,0.16"];
  edge  [arrowsize=0.9];
  c0 [label="/control\n15 nodes · 117 callbacks\n7 hops · 51 state reads"];
  c1 [label="/localization\n12 nodes · 84 callbacks\nGPU 12 · 37 hops · 7 state reads"];
  c2 [label="/map\n7 nodes · 32 callbacks\n8 hops"];
  c3 [label="/perception\n36 nodes · 157 callbacks\nGPU 42 · 20 hops · 7 state reads"];
  c4 [label="/planning\n29 nodes · 161 callbacks\n31 hops · 18 state reads"];
  c5 [label="/sensing\n33 nodes · 171 callbacks\nGPU 8 · 157 hops · 15 state reads"];
  ext_in [label="ext:in", shape=ellipse, fillcolor="#e6e6e6", color="#999999", fontcolor="#333333", fontsize=20];
  ext_out [label="ext:out", shape=ellipse, fillcolor="#e6e6e6", color="#999999", fontcolor="#333333", fontsize=20];
  {rank=same; c1; c2;}
  ext_in -> c5 [style=invis weight=1000 minlen=1];
  c5 -> c1 [style=invis weight=1000 minlen=1];
  c1 -> c3 [style=invis weight=1000 minlen=1];
  c3 -> c4 [style=invis weight=1000 minlen=1];
