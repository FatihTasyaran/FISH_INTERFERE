digraph components {
  rankdir=TB;
  newrank=true;
  graph [fontname="Helvetica" fontsize=22 nodesep=0.55 ranksep=0.85 bgcolor="white" splines=spline];
  node  [shape=box style="filled,rounded" fontname="Helvetica" fontsize=22 fillcolor="#3aa6b0" color="#2a7f87" fontcolor="white" penwidth=2 margin="0.28,0.16"];
  edge  [arrowsize=0.9];
  c0 [label="/control\n15 nodes · 117 callbacks"];
  c1 [label="/localization\n12 nodes · 84 callbacks\n12 GPU"];
  c2 [label="/map\n7 nodes · 32 callbacks"];
  c3 [label="/perception\n36 nodes · 157 callbacks\n42 GPU"];
  c4 [label="/planning\n29 nodes · 161 callbacks"];
  c5 [label="/sensing\n33 nodes · 171 callbacks\n8 GPU"];
  ext_in [label="ext:in", shape=ellipse, fillcolor="#e6e6e6", color="#999999", fontcolor="#333333", fontsize=20];
  ext_out [label="ext:out", shape=ellipse, fillcolor="#e6e6e6", color="#999999", fontcolor="#333333", fontsize=20];
  {rank=same; c1; c2;}
  ext_in -> c5 [style=invis weight=100];
  c5 -> c1 [style=invis weight=100];
  c1 -> c3 [style=invis weight=100];
  c3 -> c4 [style=invis weight=100];
  c4 -> c0 [style=invis weight=100];
  c0 -> ext_out [style=invis weight=100];
  c2 -> c1 [color="#222222", penwidth=1.20];
  c2 -> c3 [color="#222222", penwidth=1.88];
  c2 -> c3 [color="#e07b00", penwidth=1.20 style=dashed arrowhead=onormal];
  c2 -> c4 [color="#222222", penwidth=1.20];
  c2 -> c4 [color="#e07b00", penwidth=1.43 style=dashed arrowhead=onormal];
  c2 -> c0 [color="#e07b00", penwidth=1.43 style=dashed arrowhead=onormal];
  c2 -> ext_out [color="#222222", penwidth=1.20];
  c5 -> c3 [color="#222222", penwidth=3.25];
  c5 -> ext_out [color="#222222", penwidth=1.20];
  c5 -> c1 [color="#222222", penwidth=3.63];
  c5 -> c0 [color="#e07b00", penwidth=2.99 style=dashed arrowhead=onormal];
  c1 -> c5 [color="#222222", penwidth=2.95];
  c1 -> ext_out [color="#222222", penwidth=1.20];
  c1 -> c2 [color="#222222", penwidth=1.20];
  c1 -> c3 [color="#222222", penwidth=1.20];
  c5 -> c1 [color="#e07b00", penwidth=2.31 style=dashed arrowhead=onormal];
  c1 -> c5 [color="#e07b00", penwidth=3.52 style=dashed arrowhead=onormal];
  c1 -> c4 [color="#222222", penwidth=3.88];
  c1 -> c4 [color="#e07b00", penwidth=3.92 style=dashed arrowhead=onormal];
  c1 -> c0 [color="#e07b00", penwidth=4.10 style=dashed arrowhead=onormal];
  c1 -> c3 [color="#e07b00", penwidth=3.51 style=dashed arrowhead=onormal];
  c3 -> ext_out [color="#222222", penwidth=1.20];
  c3 -> c4 [color="#e07b00", penwidth=3.52 style=dashed arrowhead=onormal];
  c3 -> c0 [color="#e07b00", penwidth=3.36 style=dashed arrowhead=onormal];
  c4 -> ext_out [color="#222222", penwidth=1.20];
  c4 -> c0 [color="#e07b00", penwidth=2.97 style=dashed arrowhead=onormal];
  c0 -> ext_out [color="#222222", penwidth=1.20];
  c0 -> c4 [color="#e07b00", penwidth=1.78 style=dashed arrowhead=onormal];
  c5 -> c3 [color="#e07b00", penwidth=1.72 style=dashed arrowhead=onormal];
  c3 -> c2 [color="#222222", penwidth=1.20];
  c3 -> c1 [color="#222222", penwidth=1.20];
  ext_in -> c4 [color="#e07b00", penwidth=1.20 style=dashed arrowhead=onormal];
  ext_in -> c0 [color="#e07b00", penwidth=1.83 style=dashed arrowhead=onormal];
  ext_in -> c5 [color="#222222", penwidth=1.20];
  ext_in -> c2 [color="#222222", penwidth=1.20];
  subgraph cluster_legend {
    label="edges"; fontsize=22; fontname="Helvetica-Bold"; style="rounded"; color="#cccccc";
    node [shape=plaintext style="" fillcolor="white" fontcolor="#222222" fontsize=20];
    lg0a [label=""; shape=point; width=0.02; color="white"];
    lg0b [label="trigger — a message that starts work in the receiver"];
    lg0a -> lg0b [color="#222222", penwidth=2.4, constraint=false];
    lg1a [label=""; shape=point; width=0.02; color="white"];
    lg1b [label="sampled — the receiver reads the latest value (sample-and-hold)"];
    lg1a -> lg1b [color="#e07b00", penwidth=2.4 style=dashed arrowhead=onormal, constraint=false];
    lg0b -> lg1a [style=invis];
    lgw [label="width \u221d number of messages"];
    lg1b -> lgw [style=invis];
  }
}