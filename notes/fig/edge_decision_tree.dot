// Generated by Claude Fable 5.1 (Anthropic), 2026-09-14 — FISH edge decision tree (callback layer)
digraph fish_edges {
  rankdir=TB; nodesep=0.35; ranksep=0.45; splines=polyline;
  node [fontname="Helvetica" fontsize=11 shape=box style="rounded,filled" fillcolor="#f7f7f7" color="#555555"];
  edge [fontname="Helvetica" fontsize=10 color="#555555"];

  in [label="evidence for a pair of callbacks (a, b)\ninit events: what is wired · execution events: what happened" shape=note fillcolor="#fff8dc"];

  node [shape=diamond style=filled fillcolor="#eef3fb" fontsize=11];
  q1 [label="Q1  publisher P (node X) and subscription S (node Y)\nshare a ROS topic T?\n[rcl_publisher_init, rcl_subscription_init]\n(services ride hidden DDS rq/rr request-reply topics\nthat rcl never exposes: they are not seen here)"];
  q2 [label="Q2  client C (node X) and service V (node Y)\nshare a service?\n[rcl_client_init, rcl_service_init]\n(an action = 3 services here + feedback/status topics in Q1)"];
  q3 [label="Q3  in one node, a DATA topic T is published\nfrom ≥ 2 different subscription callbacks?\n[publish_link; infra topics excluded]"];
  q4 [label="Q4  was a message of subscription S pulled by application code?\na ros2:rmw_take (taken = 1) on S's rmw handle at time t, on thread τ;\nr = innermost callback with callback_start ≤ t ≤ callback_end on τ.\nr exists, r is not S's own callback, and S's topic is a data topic?\n(executor dispatch takes fall outside every window: not counted)\n[rmw_take (per_instance) + callback_start/end]"];
  q5 [label="Q5  S: data sub, fired ≥ 1, its entity publishes\nno data topic, not a join member;\nP = callbacks of the node publishing ≥ 1 data topic"];

  node [shape=box style="rounded,filled" fontsize=11];
  msg  [label="msg  a → b\nL2 P→S from init; L3 a→b where a is the callback that published T\n(both delivery copies if S is intra-process capable)\nflags: intra_node (X = Y), external (one side untraced)\nmeasure: DDS rmw_take ↔ publish by source_timestamp\nIPC: consumer start ↔ last rcl_publish ≤ 50 ms (only if rcl_publish fired)\npure intra-process / idle topic: hop unmeasured" fillcolor="#e3f2e1"];
  dep  [label="dep\nrequest  C(main) → V(main)\nresponse V(main) → C(continuation, split by client_link;\nfallback C main)\nexec: fish_rclcpp_client_request_sent / response_received,\nservice callback_start/end  ·  measure: round trip" fillcolor="#fde9d9"];
  join [label="join  member → anchor completer\ncompleters: the publishing subs · members: other subs with\nthe same msg_type on data topics · timeout: timers publishing T\nmembership tie, NOT a hop; no data edge invented" fillcolor="#efe3f5"];
  pol  [label="polled-msg  (observed)  S → r\nn_polls · age = take_ts − source_timestamp\nS's own callback never fires by design" fillcolor="#fff2cc"];
  inf  [label="state-inferred  (assumed; not in the paper)  S → p, for every p ∈ P\nage = start(p) − last start(S) before it\ndeclared structural assumption" fillcolor="#fff2cc"];
  none [label="no edge\nknown blind spots: tf2 buffer reads (/tf is infra),\ncuda_blackboard payload (only the key travels), loaned takes\n(no tracepoint), intra-process hops (edge exists, unmeasured)" fillcolor="#eeeeee"];

  in -> q1;
  q1 -> msg [label=" yes"]; q1 -> q2 [label=" no"];
  q2 -> dep [label=" yes"]; q2 -> q3 [label=" no"];
  q3 -> join [label=" yes"]; q3 -> q4 [label=" no"];
  q4 -> pol [label=" yes"]; q4 -> q5 [label=" no"];
  q5 -> inf [label=" yes"]; q5 -> none [label=" no"];

  lift [label="every L3 edge is lifted to E / N / EX by the union rule\nprecedence: join membership removes S from Q5 · a polled S never fires, so never enters Q5 ·\nan (S, p) pair that is both inferred and polled is emitted as polled" shape=note fillcolor="#fff8dc"];
  {rank=same; msg; dep; join; pol; inf; none;}
  msg -> lift [style=invis]; none -> lift [style=invis];
}
