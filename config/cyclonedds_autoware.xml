<?xml version="1.0" encoding="UTF-8" ?>
<!--
  CycloneDDS configuration for Autoware under FISH.

  Verbatim from
  https://docs.autoware.org/main/installation/additional-settings-for-developers/network-configuration/dds-settings/
  (fetched 2026-08-16). Autoware states CycloneDDS is "the recommended and
  most tested DDS implementation"; without this file Cyclone runs with
  MaxMessageSize ~14.7 kB and default socket buffers, and the ~600 kB top
  Velodyne frames fragment into ~40 datagrams that overflow the kernel IP
  reassembly pool (see notes: session fish_20260816_162248, top lidar
  53/288 delivered while left/right ~99%).

  Requires host sysctls (Autoware doc, same page):
      net.core.rmem_max=2147483647
      net.ipv4.ipfrag_time=3
      net.ipv4.ipfrag_high_thresh=134217728
  FISH records these in snapshot/env.txt for every session.

  Activation: install_fish.sh copies this to /opt/ros/humble/fish/, and the
  FISH ros2 wrapper exports CYCLONEDDS_URI=file:///opt/ros/humble/fish/cyclonedds_autoware.xml
  when [ros] cyclonedds_uri is set in fish_settings.ini and the env does not
  already define CYCLONEDDS_URI.
-->
<CycloneDDS xmlns="https://cdds.io/config" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface autodetermine="false" name="lo" priority="default" multicast="default" />
      </Interfaces>
      <AllowMulticast>default</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
    </General>
    <Discovery>
      <ParticipantIndex>none</ParticipantIndex>
    </Discovery>
    <Internal>
      <SocketReceiveBufferSize min="10MB"/>
      <Watermarks>
        <WhcHigh>500kB</WhcHigh>
      </Watermarks>
    </Internal>
  </Domain>
</CycloneDDS>
