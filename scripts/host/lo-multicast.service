# Generated by Claude Fable 5.1 (Anthropic)
# Enable multicast on the loopback interface at boot (Cyclone DDS single-host
# setup: discovery + data over lo multicast; Autoware recommendation). The
# flag does not survive reboots, and it was found OFF on 2026-09-05.
# Install:  sudo cp scripts/host/lo-multicast.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now lo-multicast.service
[Unit]
Description=Enable multicast on lo (Cyclone DDS)
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/ip link set dev lo multicast on
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
